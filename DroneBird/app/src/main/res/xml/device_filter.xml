<?xml version="1.0" encoding="utf-8"?>
<!--
  USB attach filter for the DJI RC-N1 "DJI USB VCOM For Protocol" device.

  VERIFY VIA DIAGNOSTIC: the values below are the common DJI defaults. Read the
  real Vendor/Product ID from the Diagnostic screen (it prints the matched
  device's VID/PID) or from a USB-info app, then replace both the decimal values
  here AND the constants in usb/DjiProtocol.kt.

  Note: <usb-device> vendor-id / product-id are DECIMAL.
  0x2CA3 = 11427 (DJI).  product-id left generic; narrow it once you read the real one.
-->
<resources>
    <usb-device vendor-id="11427" />
</resources>
