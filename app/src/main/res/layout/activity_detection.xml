<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/detection_title"
        android:textColor="@color/hud_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/state_no_device"
        android:textColor="@color/hud_amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDevice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="36dp"
        android:fontFamily="monospace"
        android:text="@string/device_none"
        android:textColor="@color/hud_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_retry" />

    <Button
        android:id="@+id/btnDiagnostic"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_diagnostic" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_play" />

</LinearLayout>
