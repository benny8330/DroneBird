<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_title"
        android:textColor="@color/hud_text"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="@string/menu_subtitle"
        android:textColor="@color/rc_green"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_play" />

    <Button
        android:id="@+id/btnDetection"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_detection" />

    <Button
        android:id="@+id/btnDiagnostic"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_diagnostic" />

</LinearLayout>
